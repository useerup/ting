{
  "name": "ting",
  "displayName": "ting",
  "description": "Ting language highlighting",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.106.1"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [{
      "id": "ting",
      "aliases": ["", "ting"],
      "extensions": [".md",".ting.md"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "ting",
      "scopeName": "source.ting",
      "path": "./syntaxes/ting.tmLanguage.json"
    }]
  }
}
