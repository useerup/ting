      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TingCompilerCli\TingCompilerCli.fsproj" />
    <ProjectReference Include="..\Compiler\Compiler.fsproj" />
    <ProjectReference Include="..\Ting.Parser\Ting.Parser.fsproj" />
    <ProjectReference Include="..\Ting.Ast\Ting.Ast.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="ExampleNotebookTests.fs" />
    <Compile Include="RangeTests.fs" />
  </ItemGroup>

</Project>
