

    // ------ begin parser combinators ------

    Rule = Any-->Parser
    Parser = string-->string

    Char = c => [c]+s => s

    OneOrMore = Rule rule => [head]+tail => rule head >> ZeroOrMore rule tail
    ZeroOrMore = Rule rule => ([head]+tail => rule head >> ZeroOrMore rule tail) || func string

    OneOrMoreDelimited = 
    ZeroOrMoreDelimited = 

    // ------ end parser combinators ------

    Digit = { '0'...'9' } >> Char
    Number = BigInteger.Parse(digits) => OneOrMore Digit digits
    Interval = (BigInteger start,BigInteger end) => Number start >> Char '-' >> Number end

    Intervals = intervals => OneOrMoreDelimited (Char ',') Interval intervals

    (Intervals input).Sum((start,end)=>[start...end].Where() )